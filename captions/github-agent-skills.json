[
 {
  "start": 0.094,
  "end": 2.123,
  "text": "Tired of re-explaining the same task to"
 },
 {
  "start": 2.123,
  "end": 3.9,
  "text": "your AI agent every week?"
 },
 {
  "start": 4.548,
  "end": 6.541,
  "text": "An agent skill is a versioned folder"
 },
 {
  "start": 6.541,
  "end": 9.077,
  "text": "built around a SKILL.md file that says"
 },
 {
  "start": 9.077,
  "end": 10.114,
  "text": "when and how to do"
 },
 {
  "start": 10.114,
  "end": 11.302,
  "text": "a repeatable task."
 },
 {
  "start": 11.954,
  "end": 13.826,
  "text": "Skills can be shared across agents,"
 },
 {
  "start": 13.924,
  "end": 16.114,
  "text": "but the host still supplies the tools,"
 },
 {
  "start": 16.141,
  "end": 17.906,
  "text": "credentials, and permissions."
 },
 {
  "start": 18.145,
  "end": 20.068,
  "text": "A skill can describe a database query"
 },
 {
  "start": 20.068,
  "end": 21.574,
  "text": "without granting access."
 },
 {
  "start": 22.216,
  "end": 24.504,
  "text": "GitHub's example is a verifier skill built"
 },
 {
  "start": 24.504,
  "end": 28.027,
  "text": "on one rule: self-verification is not verification."
 },
 {
  "start": 28.686,
  "end": 30.122,
  "text": "Write your know-how down once,"
 },
 {
  "start": 30.16,
  "end": 31.832,
  "text": "and every agent can reuse it."
 }
]