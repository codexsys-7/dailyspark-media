  "text": "labels are scarce?"
 },
 {
  "start": 4.26,
  "end": 6.545,
  "text": "Real projects often have little labeled data"
 },
 {
  "start": 6.583,
  "end": 8.255,
  "text": "but lots of unlabeled data."
 },
 {
  "start": 8.506,
  "end": 10.664,
  "text": "This paper tests ML engineering agents"
 },
 {
  "start": 10.664,
  "end": 11.45,
  "text": "in that setting."
 },
 {
  "start": 12.098,
  "end": 15.527,
  "text": "The agents wrote code combining semi-supervised techniques,"
 },
 {
