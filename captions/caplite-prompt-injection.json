[
 {
  "start": 0.094,
  "end": 2.017,
  "text": "Small AI agents can't be trusted to"
 },
 {
  "start": 2.017,
  "end": 3.759,
  "text": "write their own security rules."
 },
 {
  "start": 4.416,
  "end": 7.506,
  "text": "Several prompt-injection defenses ask the agent's own"
 },
 {
  "start": 7.506,
  "end": 9.531,
  "text": "model to write a security policy."
 },
 {
  "start": 9.77,
  "end": 11.571,
  "text": "Across 15 open models,"
 },
 {
  "start": 11.633,
  "end": 14.566,
  "text": "mostly 1.7 to 12 billion parameters,"
 },
 {
  "start": 14.676,
  "end": 16.476,
  "text": "those policies let attacks through."
 },
 {
  "start": 17.114,
  "end": 19.906,
  "text": "CapLite derives rules from the tool definitions,"
 },
 {
  "start": 19.98,
  "end": 21.867,
  "text": "and only allows an action if who"
 },
 {
  "start": 21.867,
  "end": 23.341,
  "text": "or what it affects was stated in"
 },
 {
  "start": 23.341,
  "end": 24.552,
  "text": "your actual request."
 },
 {
  "start": 25.192,
  "end": 28.188,
  "text": "No attack succeeded in nearly 14,000 attacked"
 },
 {
  "start": 28.188,
  "end": 30.794,
  "text": "episodes, and it used just 18 percent"
 },
 {
  "start": 30.794,
  "end": 31.934,
  "text": "of CaMeL's tokens."
 },
 {
  "start": 32.61,
  "end": 34.697,
  "text": "For small agents, security should come from"
 },
 {
  "start": 34.697,
  "end": 36.168,
  "text": "code, not the model."
 }
]