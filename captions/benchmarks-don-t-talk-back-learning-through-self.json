[
 {
  "start": 0.967,
  "end": 1.75,
  "text": "A model can answer"
 },
 {
  "start": 1.75,
  "end": 3.011,
  "text": "well and still fold"
 },
 {
  "start": 3.011,
  "end": 3.533,
  "text": "under wrong"
 },
 {
  "start": 3.533,
  "end": 4.43,
  "text": "counter-reasoning."
 },
 {
  "start": 4.912,
  "end": 5.836,
  "text": "Benchmarks usually"
 },
 {
  "start": 5.836,
  "end": 7.168,
  "text": "test a model alone."
 },
 {
  "start": 7.238,
  "end": 8.129,
  "text": "But deployment is"
 },
 {
  "start": 8.129,
  "end": 8.994,
  "text": "messier:"
 },
 {
  "start": 9.075,
  "end": 9.586,
  "text": "answers get"
 },
 {
  "start": 9.586,
  "end": 10.368,
  "text": "contested,"
 },
 {
  "start": 10.368,
  "end": 11.173,
  "text": "and correct ones can"
 },
 {
  "start": 11.173,
  "end": 11.962,
  "text": "be dropped."
 },
 {
  "start": 12.438,
  "end": 13.275,
  "text": "The paper calls this"
 },
 {
