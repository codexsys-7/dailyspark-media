 },
 {
  "start": 13.807,
  "end": 14.673,
  "text": "competence."
 },
 {
  "start": 14.731,
  "end": 15.47,
  "text": "It is separate from"
 },
 {
  "start": 15.47,
  "end": 16.133,
  "text": "first-answer"
 },
 {
  "start": 16.133,
  "end": 16.894,
  "text": "accuracy,"
 },
 {
  "start": 16.894,
  "end": 17.905,
  "text": "and accuracy training"
 },
 {
  "start": 17.905,
  "end": 18.731,
  "text": "alone can drift"
 },
 {
  "start": 18.731,
  "end": 19.477,
  "text": "against it."
 },
 {
  "start": 19.964,
  "end": 21.018,
  "text": "The proposed fix is"
 },
 {
  "start": 21.018,
  "end": 22.122,
  "text": "Self-Disagreement."
 },
 {
  "start": 22.192,
  "end": 22.996,
  "text": "One model states a"
 },
 {
  "start": 22.996,
  "end": 23.703,
  "text": "position,"
 },
 {
  "start": 23.703,
  "end": 24.203,
  "text": "generates the"
 },
 {
  "start": 24.203,
  "end": 25.007,
  "text": "strongest case"
 },
 {
  "start": 25.007,
  "end": 25.736,
  "text": "against it,"
 },
 {
  "start": 25.736,
  "end": 26.496,
  "text": "then rules on that"
 },
 {
  "start": 26.496,
  "end": 27.231,
  "text": "case."
 },
 {
  "start": 27.695,
  "end": 28.304,
  "text": "Training uses"
 },
 {
  "start": 28.304,
  "end": 29.412,
  "text": "verifiable rewards"
 },
 {
  "start": 29.412,
  "end": 30.158,
  "text": "throughout."
 },
 {
  "start": 30.217,
  "end": 31.315,
  "text": "No second model,"
 },
 {
  "start": 31.315,
  "end": 32.51,
  "text": "no reward model,"
 },
 {
  "start": 32.51,
  "end": 33.565,
  "text": "no preference data,"
 },
 {
  "start": 33.565,
  "end": 34.195,
  "text": "and no human"
 },
 {
  "start": 34.195,
  "end": 35.217,
  "text": "annotation enter"
 },
 {
  "start": 35.217,
  "end": 35.951,
  "text": "anywhere."
 },
 {
  "start": 36.41,
  "end": 37.204,
  "text": "A new training loop"
 },
 {
  "start": 37.204,
